{
  "name": "@sophiacyl/dsh-plugin-waves",
  "version": "0.1.0-beta.1",
  "license": "GPL-3.0",
  "type": "module",
  "description": "鸣潮 dsh-go 原生测试适配：查询、面板、练度与设置；基于 Loping151/dsh-plugin-waves",
  "main": "lib/index.js",
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "install.sh",
    "install.ps1",
    "ICON.png",
    "service/rover",
    "service/tools",
    "service/ai",
    "service/knowledge",
    "service/pyproject.toml",
    "service/ICON.png",
    "service/plugins/__init__.py",
    "DSH-GO-VERIFICATION.md",
    "tests"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "鸣潮",
      "en": "Waves"
    },
    "icon": "star",
    "assets": "service/data/media",
    "capabilities": [
      "files"
    ],
    "contributes": {
      "composer.actions": [
        {
          "id": "waves-open",
          "label": "鸣潮",
          "icon": "star",
          "effect": {
            "type": "open",
            "page": "panel:waves-home"
          }
        }
      ],
      "panels": [
        {
          "id": "waves-home",
          "title": "鸣潮查询",
          "icon": "star",
          "placement": [
            "session.tab",
            "features",
            "chat.panel"
          ]
        },
        {
          "id": "waves-settings",
          "title": "鸣潮设置",
          "icon": "settings",
          "placement": [
            "features"
          ]
        },
        {
          "id": "waves-edit",
          "title": "修改设置",
          "icon": "edit",
          "placement": [
            "plugin"
          ]
        }
      ]
    },
    "minApp": "1.0.13"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7 || ^0.2.0-rc.2 || 0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7 || ^0.2.0-rc.2 || 0.2.2-rc.1",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.7 || ^0.2.0-rc.2 || 0.2.2-rc.1",
    "@deepseek-ai/dsh-attachment": "^0.1.0-rc.7 || ^0.2.0-rc.2 || 0.2.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": "^22.19.0 || >=24.2.0",
    "dsh": "^0.1.0-rc.7 || ^0.2.0-rc.2 || 0.2.2-rc.1"
  },
  "icon": "./ICON.png",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "tag": "beta"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sophiacyl/dsh-plugin-waves.git"
  },
  "homepage": "https://github.com/Sophiacyl/dsh-plugin-waves/tree/release/npm",
  "bugs": {
    "url": "https://github.com/Sophiacyl/dsh-plugin-waves/issues"
  }
}
